        "adapter_status": "COMPLETE",
        "exit_code": 0,
        "gaps": [],
        "runtime_rows": [
          [
            "use",
            2,
            "call_1",
            "shell",
            {
              "command": "echo hi"
            }
          ],
          [
            "res",
            3,
            "call_1",
            "hi"
          ]
        ],
        "partial_output_allowed": false,
        "ignored_counts": {}
      },
      "rationale": "Mapping v1 section 3 (pairing) and section 5 (status).",
      "harness_blackbox": {
        "input": "runtime.jsonl",
        "capture_status": "COMPLETE_WITHIN_BOUNDARY",
        "valid_package": true
      }
