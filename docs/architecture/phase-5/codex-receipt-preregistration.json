{
  "registry_id": "CODEX-RECEIPT-PREREG-V1",
  "mapping_version": 1,
  "mapping_spec": "docs/architecture/phase-5/codex-receipt-mapping.md",
  "row_notation": {
    "use": "[\"use\", raw_line, call_id, name, input]",
    "res": "[\"res\", raw_line, call_id, content]"
  },
  "gap_notation": "[code, raw_line or null]; list sorted by (line with null first, code)",
  "rule": "Expected values were written before the adapter existed and must not be edited to match its output. A change needs a new registry id and a Human decision.",
